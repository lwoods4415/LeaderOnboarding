# Copy to .env.local for local development, and add the same values in Vercel
# (Project → Settings → Environment Variables).

# Public: safe in the browser. From Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER-ONLY: never prefix with NEXT_PUBLIC_, never share. Used to send invites and manage access.
SUPABASE_SECRET_KEY=sb_secret_...

# SERVER-ONLY: the address leaders use, for links in invite emails.
SITE_URL=https://www.growlikealeader.com

# SERVER-ONLY: Anthropic API key for the practice partner (console.anthropic.com → API Keys).
ANTHROPIC_API_KEY=sk-ant-...

# Optional server-only settings for the practice partner (defaults shown).
# PRACTICE_MESSAGE_MODEL=claude-haiku-5-5
# PRACTICE_FEEDBACK_MODEL=claude-sonnet-5-5
# PRACTICE_MESSAGES_PER_DAY=150
# PRACTICE_FEEDBACK_PER_DAY=15
